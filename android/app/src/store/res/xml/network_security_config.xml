<?xml version="1.0" encoding="utf-8"?>
<!-- store flavor: 禁止明文 HTTP。正式 AUTH/CHAT 必须走 HTTPS。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
